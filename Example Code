#include <stdio.h>
#include <string.h>

int main(int argc, char *argv[]) {
    struct {
        char buf[8];
        int authorized;
    } s;

    s.authorized = 0;
    strncpy(s.buf, argv[1], sizeof(s.buf) - 1);
    s.buf[sizeof(s.buf) - 1] = '\0';   // strncpy may not terminate

    printf("buf        = %s\n", s.buf);
    printf("authorized = %d\n", s.authorized);
    return 0;
}
