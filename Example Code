#include <stdio.h>
#include <string.h>

int main(int argc, char *argv[]) {
    struct {
        char buf[8];
        int authorized;
    } s;

    s.authorized = 0;
    strcpy(s.buf, argv[1]);   // no length check

    printf("buf        = %s\n", s.buf);
    printf("authorized = %d\n", s.authorized);

    if (s.authorized)
        printf("Access granted!\n");
    else
        printf("Access denied.\n");
    return 0;
}
